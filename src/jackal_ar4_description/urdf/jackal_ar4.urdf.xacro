<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="jackal_ar4">

  <xacro:arg name="prefix" default="" />
  <xacro:arg name="arm_prefix" default="ar4_" />
  <xacro:arg name="is_sim" default="false" />
  <!-- Path to ros2_controllers.yaml consumed by the gz_ros2_control Gazebo plugin -->
  <xacro:arg name="gazebo_controllers"
    default="$(find jackal_ar4_moveit_config)/config/ros2_controllers.yaml" />
  <xacro:arg name="namespace" default="" />

  <!-- Include Common Materials and macros -->
  <xacro:include filename="$(find clearpath_platform_description)/urdf/common.urdf.xacro" />

  <!-- Include Jackal base -->
  <xacro:include filename="$(find clearpath_platform_description)/urdf/j100/j100.urdf.xacro" />

  <!-- Include AR4 arm (custom macro) -->
  <xacro:include filename="$(find jackal_ar4_description)/urdf/ar4_arm.urdf.xacro" />

  <!-- Instantiate Jackal -->
  <xacro:j100 />

  <!-- Chassis Color Override (Yellow) -->
  <link name="chassis_visual_yellow">
    <visual>
      <origin xyz="0 0 -0.0655" rpy="1.570796 0 1.570796"/>
      <geometry>
        <mesh filename="package://clearpath_platform_description/meshes/j100/j100_base.stl" scale="1.001 1.001 1.001"/>
      </geometry>
      <material name="clearpath_yellow"/>
    </visual>
  </link>
  <joint name="chassis_visual_yellow_joint" type="fixed">
    <parent link="chassis_link"/>
    <child link="chassis_visual_yellow"/>
    <origin xyz="0 0 0" rpy="0 0 0"/>
  </joint>

  <!-- AR4 Mount Plate -->
  <link name="ar4_mount_plate">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry><box size="0.2 0.2 0.01"/></geometry>
      <material name="clearpath_black"/>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry><box size="0.2 0.2 0.01"/></geometry>
    </collision>
    <inertial>
      <mass value="0.5"/>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <inertia ixx="0.002" ixy="0.0" ixz="0.0" iyy="0.002" iyz="0.0" izz="0.003"/>
    </inertial>
  </link>
  <joint name="ar4_mount_joint" type="fixed">
    <parent link="default_mount"/>
    <child link="ar4_mount_plate"/>
    <origin xyz="0 0 0.005" rpy="0 0 0"/>
  </joint>

  <!-- Instantiate AR4 arm -->
  <xacro:ar4_arm prefix="$(arg arm_prefix)" />

  <!-- Joint Mount plate to AR4 base -->
  <joint name="mount_to_ar4_joint" type="fixed">
    <parent link="ar4_mount_plate"/>
    <child link="$(arg arm_prefix)base_link"/>
    <origin xyz="0 0 0.005" rpy="0 0 0"/>
  </joint>

  <!-- ros2_control -->
  <xacro:include filename="$(find jackal_ar4_description)/urdf/jackal_ar4.ros2_control.xacro" />

  <!-- ── LiDAR link (always present so TF tree is complete) ──────────────
       Mounted at front-centre of chassis, 15 cm above chassis_link.
       Named 'lidar' to match mobo_bot sensor reference convention.
  -->
  <link name="lidar">
    <visual>
      <origin xyz="0 0 -0.02"/>
      <geometry><cylinder radius="0.03" length="0.04"/></geometry>
      <material name="clearpath_black"/>
    </visual>
    <collision>
      <origin xyz="0 0 -0.02"/>
      <geometry><cylinder radius="0.03" length="0.04"/></geometry>
    </collision>
    <inertial>
      <mass value="0.2"/>
      <origin xyz="0 0 -0.02" rpy="0 0 0"/>
      <inertia ixx="0.0001" ixy="0" ixz="0" iyy="0.0001" iyz="0" izz="0.0001"/>
    </inertial>
  </link>
  <joint name="lidar_joint" type="fixed">
    <parent link="chassis_link"/>
    <child link="lidar"/>
    <origin xyz="0.18 0.0 0.15" rpy="0 0 0"/>
  </joint>

  <!-- ── Gazebo plugins (only when is_sim:=true) ──────────────────────── -->
  <xacro:if value="$(arg is_sim)">

    <!-- Differential drive: wheels physics + /odom + /tf odom->base_link.
         Odom drifts over time due to wheel slip; AMCL corrects the drift
         by publishing map->odom from LiDAR-to-map matching. -->
    <gazebo>
      <plugin filename="gz-sim-diff-drive-system"
              name="gz::sim::systems::DiffDrive">
        <left_joint>front_left_wheel_joint</left_joint>
        <left_joint>rear_left_wheel_joint</left_joint>
        <right_joint>front_right_wheel_joint</right_joint>
        <right_joint>rear_right_wheel_joint</right_joint>
        <wheel_separation>0.37559</wheel_separation>
        <wheel_radius>0.098</wheel_radius>
        <odom_publish_frequency>50</odom_publish_frequency>
        <topic>/cmd_vel</topic>
        <odom_topic>/odom</odom_topic>
        <frame_id>odom</frame_id>
        <child_frame_id>base_link</child_frame_id>
        <tf_topic>/tf</tf_topic>
      </plugin>
    </gazebo>

    <!-- Publish wheel joint states from Gazebo to /wheel_joint_states -->
    <gazebo>
      <plugin filename="gz-sim-joint-state-publisher-system"
              name="gz::sim::systems::JointStatePublisher">
        <topic>/wheel_joint_states</topic>
        <joint_name>front_left_wheel_joint</joint_name>
        <joint_name>front_right_wheel_joint</joint_name>
        <joint_name>rear_left_wheel_joint</joint_name>
        <joint_name>rear_right_wheel_joint</joint_name>
      </plugin>
    </gazebo>

    <!-- gz_ros2_control: hosts the controller_manager inside Gazebo and wires
         ros2_control hardware interfaces to Gazebo joint physics.
         This replaces the standalone ros2_control_node in the launch. -->
    <gazebo>
      <plugin filename="libgz_ros2_control-system.so"
              name="gz_ros2_control::GazeboSimROS2ControlPlugin">
        <parameters>$(arg gazebo_controllers)</parameters>
        <ros>
          <namespace>$(arg namespace)</namespace>
          <remapping>/tf:=tf</remapping>
          <remapping>/tf_static:=tf_static</remapping>
        </ros>
      </plugin>
    </gazebo>

    <!-- Ground-truth odometry from physics engine (no wheel drift).
         Publishes gz.msgs.Odometry on /ground_truth_odom at 10 Hz.
         Bridged to ROS by gazebo.launch.py, consumed by gz_ground_truth_odom.py
         to compute map→odom correction. No subprocess, no performance hit. -->
    <gazebo>
      <plugin filename="gz-sim-odometry-publisher-system"
              name="gz::sim::systems::OdometryPublisher">
        <odom_topic>ground_truth_odom</odom_topic>
        <odom_frame>map</odom_frame>
        <robot_base_frame>base_link</robot_base_frame>
        <odom_publish_frequency>10</odom_publish_frequency>
        <dimensions>3</dimensions>
      </plugin>
    </gazebo>

    <!-- LiDAR sensor: 360° 10Hz gpu_lidar, topic: lidar/scan
         Pattern follows mobo_bot robot_gazebo_properties.xacro exactly.
         gz_frame_id must match link name for RViz LaserScan display. -->
    <gazebo reference="lidar">
      <sensor name="lidar" type="gpu_lidar">
        <topic>lidar/scan</topic>
        <gz_frame_id>lidar</gz_frame_id>
        <always_on>true</always_on>
        <visualize>true</visualize>
        <update_rate>10.0</update_rate>
        <ray>
          <scan>
            <horizontal>
              <samples>360</samples>
              <min_angle>-3.14159265</min_angle>
              <max_angle>3.14159265</max_angle>
              <resolution>1</resolution>
            </horizontal>
          </scan>
          <range>
            <min>0.12</min>
            <max>12.0</max>
            <resolution>0.01</resolution>
          </range>
          <noise>
            <type>gaussian</type>
            <mean>0.0</mean>
            <stddev>0.01</stddev>
          </noise>
        </ray>
      </sensor>
    </gazebo>

    <!-- Collision bitmask: robot=0x01, bottles=0x02.
         0x01 & 0x02 == 0 → robot links pass through bottles.
         Robot still collides with ground/walls/table (default 0xFFFF). -->
    <xacro:macro name="no_bottle_collision" params="link_name">
      <gazebo reference="${link_name}">
        <collision><surface><contact>
          <collide_bitmask>0x01</collide_bitmask>
        </contact></surface></collision>
      </gazebo>
    </xacro:macro>
    <xacro:no_bottle_collision link_name="chassis_link"/>
    <xacro:no_bottle_collision link_name="front_left_wheel_link"/>
    <xacro:no_bottle_collision link_name="front_right_wheel_link"/>
    <xacro:no_bottle_collision link_name="rear_left_wheel_link"/>
    <xacro:no_bottle_collision link_name="rear_right_wheel_link"/>
    <xacro:no_bottle_collision link_name="ar4_mount_plate"/>
    <xacro:no_bottle_collision link_name="lidar"/>
    <xacro:no_bottle_collision link_name="ar4_base_link"/>
    <xacro:no_bottle_collision link_name="ar4_link_1"/>
    <xacro:no_bottle_collision link_name="ar4_link_2"/>
    <xacro:no_bottle_collision link_name="ar4_link_3"/>
    <xacro:no_bottle_collision link_name="ar4_link_4"/>
    <xacro:no_bottle_collision link_name="ar4_link_5"/>
    <xacro:no_bottle_collision link_name="ar4_link_6"/>
    <xacro:no_bottle_collision link_name="ar4_gripper_base_link"/>
    <xacro:no_bottle_collision link_name="ar4_gripper_jaw1_link"/>
    <xacro:no_bottle_collision link_name="ar4_gripper_jaw2_link"/>

  </xacro:if>

</robot>
