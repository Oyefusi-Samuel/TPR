    <!-- ══════════════════════════════════════════════
         OPEN-TOP TRASH BIN
         Moved to inner corner (-1.8, -1.8) — opposite side from table
         so robot has a clear path: origin → table → bin
         Size: 0.22m x 0.22m x 0.28m tall, fully open top
    ══════════════════════════════════════════════ -->
    <model name="bin_floor">
      <static>true</static>
      <pose>-1.8 -1.8 0.010 0 0 0</pose>
      <link name="link">
        <collision name="col"><geometry><box><size>0.24 0.24 0.020</size></box></geometry></collision>
