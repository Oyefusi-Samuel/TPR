<?xml version="1.0" encoding="utf-8"?>
<robot xmlns:xacro="http://wiki.ros.org/xacro">
  <xacro:macro name="ar_gripper" params="
    tf_prefix
    parent
  ">

    <joint name="${tf_prefix}gripper_base_joint" type="fixed">
      <origin xyz="0.0 0.0 0.0" rpy="-1.5708 0.0 0.0"/>
      <parent link="${parent}"/>
      <child link="${tf_prefix}gripper_base_link"/>
    </joint>

    <link name="${tf_prefix}gripper_base_link">
      <visual>
        <geometry>
          <mesh filename="package://ar4_description/meshes/ar4_gripper/gripper_base_link.stl" />
        </geometry>
        <material name="">
          <color rgba="0.0 0.0 0.8 1.0"/>
        </material>
      </visual>
      <collision>
        <geometry>
          <mesh filename="package://ar4_description/meshes/ar4_gripper/gripper_base_link.stl" />
        </geometry>
      </collision>
      <inertial>
        <origin xyz="-0.00073621 -0.02341392 -0.00435302"/>
        <mass value="0.08"/>
        <inertia ixx="0.00002375" ixy="0.00000002" ixz="-0.00000017" iyy="0.00004082" iyz="-0.00000029" izz="0.00004254"/>
      </inertial>
    </link>
    <link name="${tf_prefix}gripper_jaw1_link">
      <visual>
        <geometry>
          <mesh filename="package://ar4_description/meshes/ar4_gripper/gripper_jaw1_link.stl" />
        </geometry>
        <material name="">
          <color rgba="0.0 0.0 0.8 1.0"/>
        </material>
      </visual>
      <collision>
        <geometry>
          <mesh filename="package://ar4_description/meshes/ar4_gripper/gripper_jaw1_link.stl" />
        </geometry>
      </collision>
      <inertial>
        <origin xyz="-0.00435839 -0.00469536 0.00757141"/>
        <mass value="0.01"/>
        <inertia ixx="0.00000123" ixy="-0.00000004" ixz="0.00000012" iyy="0.00000115" iyz="0.00000016" izz="0.00000102"/>
      </inertial>
    </link>
    <link name="${tf_prefix}gripper_jaw2_link">
      <visual>
        <geometry>
          <mesh filename="package://ar4_description/meshes/ar4_gripper/gripper_jaw2_link.stl" />
        </geometry>
        <material name="">
          <color rgba="0.0 0.0 0.8 1.0"/>
        </material>
      </visual>
      <collision>
        <geometry>
          <mesh filename="package://ar4_description/meshes/ar4_gripper/gripper_jaw2_link.stl" />
        </geometry>
      </collision>
      <inertial>
        <origin xyz="-0.00423971 -0.00491236 0.00814582"/>
        <mass value="0.01"/>
        <inertia ixx="0.00000118" ixy="-0.00000004" ixz="0.00000013" iyy="0.00000110" iyz="0.00000013" izz="0.00000101"/>
      </inertial>
    </link>

    <joint name="${tf_prefix}gripper_jaw1_joint" type="prismatic">
      <origin xyz="0.0 -0.036 0" rpy="0.0 0.0 0.0"/>
      <parent link="${tf_prefix}gripper_base_link"/>
      <child link="${tf_prefix}gripper_jaw1_link"/>
      <axis xyz="-1 0 0"/>
      <!-- effort must be positive (force limit in N). Original -1 caused Gazebo
           to apply zero drive force, preventing the jaw from moving at all. -->
      <!-- lower=-0.002: Gazebo spawns this joint at ~0 with floating-point noise
           that can land at -9e-15 (slightly below 0).  A joint below its lower
           limit triggers ODE's constraint enforcement, which fights the K_p
           velocity drive even in the correct (opening) direction, permanently
           locking the jaw.  Setting lower=-0.002 keeps the nominal closed
           position (0.0 m) well above the hard stop so the constraint is
           never active at spawn time.
           upper=0.016: the K_p drive and arm-motion vibration can push the jaw
           slightly past 0.014 after opening.  A jaw above its upper limit
           triggers the same ODE constraint, locking jaw2 on the close stroke.
           0.016 keeps the nominal open position (0.014 m) well below the hard
           stop so the constraint never activates after an open command. -->
      <limit lower="-0.002" upper="0.016" effort="20" velocity="1.0"/>
      <!-- damping prevents oscillation across the 14 mm travel; friction holds
           the jaw against whatever load is in the gripper at rest -->
      <dynamics damping="0.1" friction="0.01"/>
    </joint>

    <joint name="${tf_prefix}gripper_jaw2_joint" type="prismatic">
      <origin xyz="0.0 -0.036 0" rpy="0.0 ${-pi} 0.0"/>
      <parent link="${tf_prefix}gripper_base_link"/>
      <child link="${tf_prefix}gripper_jaw2_link"/>
      <axis xyz="-1 0 0"/>
      <!-- <mimic> removed: jaw2 is now an explicitly commanded joint via
           ros2_control.  Keeping <mimic> while also registering a position
           command interface causes GazeboSimSystem to fail initialisation
           (ODE physics applies the mimic constraint AND ros2_control tries
           to drive the joint independently, creating a conflict that prevents
           any controllers — including joint_state_broadcaster — from loading,
           which breaks the entire TF tree).  Joint state is published by
           joint_state_broadcaster; robot_state_publisher picks it up normally. -->
      <limit lower="-0.002" upper="0.016" effort="20" velocity="1.0"/>
      <dynamics damping="0.1" friction="0.01"/>
    </joint>

  </xacro:macro>
</robot>
